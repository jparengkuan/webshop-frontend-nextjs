# Copy to .env.local. Validated on first use by src/config/env.ts.

# Backend (API Platform). Server-side only; inside DDEV the default works.
API_URL=https://api-platform.ddev.site

# Public URL of this app; the OAuth2 redirect URI is APP_URL/callback. DDEV sets DDEV_PRIMARY_URL.
# APP_URL=https://webshop-frontend-nextjs.ddev.site

# OAuth2 client registered on the API (bin/console league:oauth2-server:create-client).
OAUTH_CLIENT_ID=webshop-demo
OAUTH_CLIENT_SECRET=demo-secret
